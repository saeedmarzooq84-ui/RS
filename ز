<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#071a38">
<title>R|S TEAM STORE</title>
<style>
:root{--bg:#050b19;--panel:#0b1830;--blue:#1479ed;--cyan:#62baff;--muted:#a9bddb}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:#fff;font-family:Arial,sans-serif;padding-bottom:90px}
header{padding:24px 18px 20px;background:linear-gradient(140deg,#061a3e,#0757ad,#061027);border-bottom:2px solid #168cff;border-radius:0 0 25px 25px}
.logo{text-align:center;font-size:38px;font-weight:900;letter-spacing:3px;text-shadow:0 0 20px #168cff}
header p{text-align:center;color:#c5e2ff;margin:8px 0 16px}
input,textarea,select{display:block;appearance:none;-webkit-appearance:none;width:100%;min-height:46px;padding:13px;margin:6px 0;border-radius:12px;background:#102442!important;border:1px solid #285b91;color:#fff!important;-webkit-text-fill-color:#fff!important;caret-color:#62baff;font-size:16px;opacity:1}
.phone-row{display:flex;gap:8px;align-items:center;direction:ltr}.phone-row input{flex:1;min-width:0}.phone-row select{width:132px;flex:0 0 132px}.field-label{display:block;text-align:right;color:#c5e2ff;font-size:13px;margin-top:10px}
input::placeholder,textarea::placeholder{color:#a9c8e9!important;-webkit-text-fill-color:#a9c8e9!important;opacity:1}
input:focus,textarea:focus,select:focus{outline:none;border-color:#62baff;box-shadow:0 0 8px #168cff55}
.banner{margin:15px;padding:24px 15px;border-radius:20px;text-align:center;background:linear-gradient(120deg,#063b83,#07162f);border:1px solid #168cff}
.banner h2{color:var(--cyan);margin:0 0 8px}
.section{padding:15px}.page{display:none}.page.active{display:block}
.filters{display:flex;gap:8px;overflow:auto;margin:15px 0}
button{cursor:pointer;font-family:inherit}
.filters button{padding:12px 17px;border-radius:12px;background:#101d36;color:white;border:1px solid #24558c;white-space:nowrap}
.filters button.active{background:var(--blue);border-color:#62baff}
.products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.card,.info-box,.order{background:var(--panel);border:1px solid #173b68;border-radius:16px;padding:12px;margin-bottom:12px;min-width:0}
.product-img{height:105px;display:grid;place-items:center;background:linear-gradient(140deg,#092b5d,#071226);font-size:40px;border-radius:12px}
.card h3{font-size:15px;margin:10px 0 5px}.card p{font-size:12px;color:var(--muted);min-height:14px}
.price{color:var(--cyan);font-weight:bold}.status{color:#60e5ad;font-size:12px}.sold{color:#ff7777;font-size:12px}
.buy,.mainbtn{width:100%;padding:12px;border:0;border-radius:10px;background:var(--blue);color:white;margin-top:8px}
.buy:disabled{background:#444;color:#bbb}
nav{position:fixed;bottom:0;left:0;right:0;display:flex;justify-content:space-around;gap:2px;background:#080f20;border-top:1px solid #1762a8;padding:10px 2px calc(10px + env(safe-area-inset-bottom));z-index:5}
nav button{background:none;border:0;color:#899bb7;font-size:10px;min-width:0;flex:1}
nav button.active{color:#62baff}nav span{display:block;font-size:20px;margin-bottom:4px}
.modal{display:none;position:fixed;inset:0;background:#000c;z-index:10;align-items:center;justify-content:center;padding:18px}
.modal-box{background:#0b1b35;border:1px solid #168cff;border-radius:20px;padding:20px;width:100%;max-width:400px}
.modal-box h2{color:var(--cyan)}
.close{background:#293c58;color:white;border:0;padding:11px;border-radius:9px;width:100%;margin-top:8px}
.order{margin-top:12px;overflow-wrap:anywhere}.order small{color:#9bbbe2}
.success{color:#5be2a5}.rejected{color:#ff7777}
.empty{text-align:center;color:#9bbbe2;padding:25px;grid-column:1/-1}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
.admin-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin:14px 0}
.admin-tabs button,.subtab{border:1px solid #24558c;background:#102442;color:#d9ecff;border-radius:12px;padding:12px 5px;font-size:12px;min-height:54px}
.admin-tabs button.active,.subtab.active{background:linear-gradient(130deg,#1266c7,#168cff);border-color:#62baff;color:white}
.admin-view{display:none}.admin-view.active{display:block}
.admin-person{display:flex;align-items:center;gap:12px;background:#0d203c;border:1px solid #1b5488;border-radius:15px;padding:13px;margin:10px 0}
.admin-avatar{width:43px;height:43px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#1479ed,#62baff);font-size:20px;flex-shrink:0}
.online-dot{width:9px;height:9px;border-radius:50%;background:#52e6a5;display:inline-block;margin-left:5px;box-shadow:0 0 8px #52e6a5}
.admin-person small{color:#9bbbe2}.admin-person .person-info{flex:1;min-width:0}
.master-box{border:1px solid #8a6ad8;background:linear-gradient(145deg,#21183f,#0b1830);border-radius:16px;padding:14px;margin-top:18px}
.master-box h3{color:#c6aaff;margin-top:0}.muted-note{color:#9bbbe2;font-size:12px;line-height:1.7}
.stat{background:#102442;border-radius:12px;padding:12px;text-align:center}
.manage-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.manage-row>*{min-width:0}.danger-btn{background:#8e293c!important}.mini-btn{padding:10px;border:0;border-radius:9px;background:#1766ad;color:#fff;margin:4px 0;width:100%}
.stat b{display:block;font-size:22px;color:var(--cyan);margin-top:5px}
@media(min-width:650px){.section{max-width:850px;margin:auto}.banner{max-width:820px;margin:18px auto}.products{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
</head>
