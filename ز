<script>
const DEFAULT_ITEMS=[
{id:1,name:"حماية الحساب",desc:"خدمة حماية الحساب",price:20,icon:"🛡️",status:"available",type:"protection"},
{id:2,name:"عضوية التيم",desc:"الانضمام إلى تيم R|S",price:30,icon:"👑",status:"available",type:"general"},
{id:3,name:"حساب عضو",desc:"حساب عضو في التيم",price:15,icon:"👤",status:"available",type:"member"},
{id:4,name:"رتبة خاصة",desc:"رتبة خاصة داخل التيم",price:10,icon:"⭐",status:"available",type:"general"},
{id:5,name:"حماية إضافية",desc:"خدمات حماية إضافية",price:25,icon:"🔐",status:"available",type:"protection"},
{id:6,name:"حساب مميز",desc:"حساب مميز",price:40,icon:"💎",status:"available",type:"member"}
];
let items=load("rs_items",DEFAULT_ITEMS);
let orders=load("rs_orders",[]);
let users=load("rs_users",[]);
let admins=load("rs_admins",[]);
let currentFilter="all",selected=null,loggedIn=false,masterUnlocked=false;

function load(key,def){
 try{return JSON.parse(localStorage.getItem(key))??JSON.parse(JSON.stringify(def))}
 catch(e){return JSON.parse(JSON.stringify(def))}
}
function saveItems(){localStorage.setItem("rs_items",JSON.stringify(items))}
function saveOrders(){localStorage.setItem("rs_orders",JSON.stringify(orders))}
function saveUsers(){localStorage.setItem("rs_users",JSON.stringify(users))}
function saveAdmins(){localStorage.setItem("rs_admins",JSON.stringify(admins))}
function escapeHTML(s){
 return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function registerUser(){
 const name=document.getElementById("regName").value.trim();
 const country=document.getElementById("regCountry").value;
 const phone=document.getElementById("regPhone").value.trim();
 const region=document.getElementById("regRegion").value.trim();
 if(!name||!phone||!region){
 document.getElementById("registerError").textContent="يرجى تعبئة جميع البيانات";
 return;
 }
 const user={name,country,phone,region};
 localStorage.setItem("rs_current_user",JSON.stringify(user));
 const old=users.find(x=>x.name===name&&x.phone===phone);
 if(!old)users.push(user);
 saveUsers();
 enterStore(user);
}
function enterStore(user){
 document.getElementById("registerGate").classList.remove("active");
 document.getElementById("appContent").style.display="block";
 document.getElementById("profileName").textContent=user.name;
 document.getElementById("profilePhone").textContent=user.country+" "+user.phone;
 document.getElementById("profileRegion").textContent=user.region;
 render();
}
function userLogout(){
 localStorage.removeItem("rs_current_user");
 location.reload();
}
function showPage(id,btn){
 document.querySelectorAll(".page").forEach(x=>x.classList.remove("active"));
 const page=document.getElementById(id);
 if(page)page.classList.add("active");
 document.querySelectorAll("nav button").forEach(x=>x.classList.remove("active"));
 if(btn)btn.classList.add("active");
 else{
 const b=document.querySelector(`nav button[data-page="${id}"]`);
 if(b)b.classList.add("active");
 }
 if(id==="admin")refreshAdmin();
 window.scrollTo(0,0);
}
function filter(type,btn){
 currentFilter=type;
 document.querySelectorAll(".filters button").forEach(x=>x.classList.remove("active"));
 btn.classList.add("active");
 render();
}
function card(i){
 const available=i.status==="available";
 return `<div class="card">
 <div class="product-img">${escapeHTML(i.icon||"🛍️")}</div>
 <h3>${escapeHTML(i.name)}</h3>
 <p>${escapeHTML(i.desc)}</p>
 <div class="price">${Number(i.price).toFixed(2)} AED</div>
 <p class="${available?"status":"sold"}">${available?"متوفر":"غير متوفر"}</p>
 <button class="buy" ${available?"":"disabled"} onclick="openBuy(${Number(i.id)})">${available?"اطلب الآن":"غير متوفر"}</button>
 </div>`;
}
function render(){
 const q=(document.getElementById("search")?.value||"").trim().toLowerCase();
 const visible=items.filter(i=>{
 const matches=(i.name+" "+i.desc).toLowerCase().includes(q);
 const status=currentFilter==="all"||i.status===currentFilter;
 return matches&&status;
 });
 document.getElementById("products").innerHTML=visible.filter(i=>i.type==="general").map(card).join("")||'<div class="empty">لا توجد منتجات</div>';
 document.getElementById("protections").innerHTML=items.filter(i=>i.type==="protection").map(card).join("")||'<div class="empty">لا توجد منتجات</div>';
 document.getElementById("memberProducts").innerHTML=items.filter(i=>i.type==="member").map(card).join("")||'<div class="empty">لا توجد منتجات</div>';
 getCustomRooms().forEach(r=>{
 const el=document.getElementById("room-products-"+r.id);
 if(el)el.innerHTML=items.filter(i=>i.type===r.id).map(card).join("")||'<div class="empty">لا توجد منتجات</div>';
 });
}
function openBuy(id){
 selected=items.find(i=>i.id===id);
 if(!selected)return;
 document.getElementById("selectedProduct").textContent=selected.name+" — "+selected.price+" AED";
 const user=load("rs_current_user",{});
 document.getElementById("customerName").value=user.name||"";
 document.getElementById("customerContact").value=user.phone||"";
 document.getElementById("customerCountry").value=user.country||"🇦🇪 +971";
 document.getElementById("customerRegion").value=user.region||"";
 document.getElementById("buyModal").style.display="flex";
}
function closeModal(){document.getElementById("buyModal").style.display="none"}
function submitOrder(){
 if(!selected)return;
 const name=document.getElementById("customerName").value.trim();
 const phone=document.getElementById("customerContact").value.trim();
 const country=document.getElementById("customerCountry").value;
 const region=document.getElementById("customerRegion").value.trim();
 if(!name||!phone||!region){alert("يرجى تعبئة جميع البيانات");return}
 const order={
 id:Date.now(),
 product:selected.name,
 price:selected.price,
 name,phone,country,region,
 status:"pending",
 date:new Date().toLocaleString("ar-AE")
 };
 orders.push(order);
 saveOrders();
 closeModal();
 document.getElementById("orderNumber").textContent="رقم الطلب: "+order.id;
 document.getElementById("successModal").style.display="flex";
}
function closeSuccess(){document.getElementById("successModal").style.display="none"}
function adminLogin(){
 if(document.getElementById("adminPassword").value!=="1111"){
 document.getElementById("loginError").textContent="الرمز غير صحيح";
 return;
 }
 loggedIn=true;
 document.getElementById("loginBox").style.display="none";
 document.getElementById("adminPanel").style.display="block";
 refreshAdmin();
}
function logout(){
 loggedIn=false;masterUnlocked=false;
 document.getElementById("loginBox").style.display="block";
 document.getElementById("adminPanel").style.display="none";
 document.getElementById("adminPassword").value="";
}
function adminTab(id,btn){
 document.querySelectorAll(".admin-view").forEach(x=>x.classList.remove("active"));
 document.getElementById(id).classList.add("active");
 document.querySelectorAll(".admin-tabs button").forEach(x=>x.classList.remove("active"));
 if(btn)btn.classList.add("active");
}
function refreshAdmin(){
 if(!loggedIn)return;
 document.getElementById("total").textContent=orders.length;
 document.getElementById("pending").textContent=orders.filter(x=>x.status==="pending").length;
 document.getElementById("accepted").textContent=orders.filter(x=>x.status==="accepted").length;
 document.getElementById("rejected").textContent=orders.filter(x=>x.status==="rejected").length;
 document.getElementById("productManager").innerHTML=items.map(i=>`
 <div class="order"><b>${escapeHTML(i.name)}</b>
 <p>${escapeHTML(i.desc)} — ${i.price} AED</p>
 <button class="mini-btn" onclick="changeStatus(${i.id})">تغيير حالة التوفر</button></div>`).join("");
 document.getElementById("orders").innerHTML=orders.slice().reverse().map(o=>`
 <div class="order"><b>${escapeHTML(o.product)}</b>
 <p>الاسم: ${escapeHTML(o.name)}</p>
 <p>الدولة: ${escapeHTML(o.country)}</p>
 <p>الهاتف: ${escapeHTML(o.phone)}</p>
 <p>المنطقة: ${escapeHTML(o.region)}</p>
 <p>السعر: ${o.price} AED</p>
 <small>${escapeHTML(o.date)}</small>
 <p>الحالة: ${escapeHTML(o.status)}</p>
 <button class="mini-btn" onclick="setOrder(${o.id},'accepted')">قبول الطلب</button>
 <button class="mini-btn danger-btn" onclick="setOrder(${o.id},'rejected')">رفض الطلب</button>
 </div>`).join("")||'<div class="empty">لا توجد طلبات</div>';
 document.getElementById("registeredUsers").innerHTML=users.map(u=>`<div class="order">${escapeHTML(u.name)} — ${escapeHTML(u.region)}</div>`).join("")||"لا يوجد أعضاء";
 document.getElementById("onlineAdmins").innerHTML=admins.filter(a=>a.active!==false).map(a=>`<div class="admin-person"><div class="admin-avatar">👤</div><div class="person-info"><b>${escapeHTML(a.name)}</b><br><small>${escapeHTML(a.role)}</small></div><span class="online-dot"></span></div>`).join("")||"لا يوجد إداريون مضافون";
}
function changeStatus(id){
 const i=items.find(x=>x.id===id);if(!i)return;
 i.status=i.status==="available"?"closed":"available";
 saveItems();refreshAdmin();render();
}
function setOrder(id,status){
 const o=orders.find(x=>x.id===id);if(!o)return;
 o.status=status;saveOrders();refreshAdmin();
}
function openMasterAdmin(btn){
 adminTab("masterTab",btn);
 document.getElementById("masterLogin").style.display="block";
 document.getElementById("masterControls").style.display="none";
 masterUnlocked=false;
}
function verifyMaster(){
 if(document.getElementById("masterPassword").value!=="0000"){
 document.getElementById("masterError").textContent="الرمز غير صحيح";return;
 }
 masterUnlocked=true;
 document.getElementById("masterLogin").style.display="none";
 document.getElementById("masterControls").style.display="block";
 document.getElementById("masterStoreName").value=localStorage.getItem("rs_store_name")||"🔥 متجر تيم R|S";
 document.getElementById("masterStoreSubtitle").value=localStorage.getItem("rs_store_subtitle")||"كل احتياجاتك في مكان واحد 💙";
 renderRoomManager();
 renderMasterProducts();
}
function applyStoreSettings(){
 document.getElementById("storeHeading").textContent=localStorage.getItem("rs_store_name")||"🔥 متجر تيم R|S";
 document.getElementById("storeSubtitle").textContent=localStorage.getItem("rs_store_subtitle")||"كل احتياجاتك في مكان واحد 💙";
 document.title=document.getElementById("storeHeading").textContent;
}
function saveStoreSettings(){
 if(!masterUnlocked)return;
 localStorage.setItem("rs_store_name",document.getElementById("masterStoreName").value.trim());
 localStorage.setItem("rs_store_subtitle",document.getElementById("masterStoreSubtitle").value.trim());
 applyStoreSettings();alert("تم حفظ إعدادات المتجر");
}
function renderMasterProducts(){
 if(!masterUnlocked)return;
 document.getElementById("masterProductManager").innerHTML=items.map(i=>`
 <div class="order"><b>${escapeHTML(i.name)}</b>
 <label class="field-label">اسم المنتج</label><input id="mp-name-${i.id}" value="${escapeHTML(i.name)}">
 <label class="field-label">الوصف</label><input id="mp-desc-${i.id}" value="${escapeHTML(i.desc)}">
 <div class="manage-row"><div><label class="field-label">السعر</label><input id="mp-price-${i.id}" type="number" value="${i.price}"></div><div><label class="field-label">الأيقونة</label><input id="mp-icon-${i.id}" value="${escapeHTML(i.icon)}"></div></div>
 <label class="field-label">الحالة</label><select id="mp-status-${i.id}"><option value="available" ${i.status==="available"?"selected":""}>متوفر</option><option value="closed" ${i.status==="closed"?"selected":""}>مغلق</option><option value="sold" ${i.status==="sold"?"selected":""}>Sold Out</option></select>
 <button class="mini-btn" onclick="saveMasterProduct(${i.id})">حفظ المنتج</button>
 <button class="mini-btn danger-btn" onclick="deleteProduct(${i.id})">حذف المنتج</button></div>`).join("")||"لا توجد منتجات";
}
function saveMasterProduct(id){
 if(!masterUnlocked)return;
 const i=items.find(x=>x.id===id);if(!i)return;
 i.name=document.getElementById("mp-name-"+id).value.trim()||i.name;
 i.desc=document.getElementById("mp-desc-"+id).value.trim();
 i.price=Math.max(0,Number(document.getElementById("mp-price-"+id).value)||0);
 i.icon=document.getElementById("mp-icon-"+id).value.trim()||"🛍️";
 i.status=document.getElementById("mp-status-"+id).value;
 saveItems();render();renderMasterProducts();refreshAdmin();
 alert("تم حفظ المنتج");
}
function getNavItems(){
 try{return JSON.parse(localStorage.getItem("rs_nav_items"))||DEFAULT_NAV.map(x=>({...x}))}
 catch(e){return DEFAULT_NAV.map(x=>({...x}))}
}
const DEFAULT_NAV=[
 {id:"home",label:"الرئيسية",icon:"⌂",fixed:true},
 {id:"store",label:"المتجر",icon:"🛒",fixed:true},
 {id:"protection",label:"حمايات",icon:"🛡️",fixed:true},
 {id:"members",label:"الأعضاء",icon:"👥",fixed:true},
 {id:"account",label:"حسابي",icon:"👤",fixed:true},
 {id:"admin",label:"ADMIN",icon:"👑",fixed:true}
];
function saveNavItems(v){
 localStorage.setItem("rs_nav_items",JSON.stringify(v));renderNavigation();
}
function getCustomRooms(){
 try{return JSON.parse(localStorage.getItem("rs_custom_rooms"))||[]}
 catch(e){return []}
}
function saveCustomRooms(v){localStorage.setItem("rs_custom_rooms",JSON.stringify(v))}
function renderNavigation(){
 const nav=document.querySelector("nav");if(!nav)return;
 const visible=getNavItems().filter(x=>x.visible!==false);
 nav.innerHTML=visible.map(x=>`<button data-page="${escapeHTML(x.id)}" onclick="showPage('${escapeHTML(x.id)}',this)"><span>${escapeHTML(x.icon||"📁")}</span>${escapeHTML(x.label||x.id)}</button>`).join("");
}
function ensureRoomPages(){
 const host=document.getElementById("appContent");
 getCustomRooms().forEach(r=>{
 if(!document.getElementById(r.id)){
 const sec=document.createElement("section");
 sec.className="page";sec.id=r.id;
 sec.innerHTML=`<div class="section"><h2>${escapeHTML(r.icon)} ${escapeHTML(r.name)}</h2><p class="muted-note">${escapeHTML(r.desc||"")}</p><div class="products" id="room-products-${r.id}"></div></div>`;
 host.insertBefore(sec,document.querySelector("nav"));
 }
 });
}
function renderRoomManager(){
 if(!masterUnlocked)return;
 const nav=getNavItems(),rooms=getCustomRooms();
 document.getElementById("navRoomManager").innerHTML=nav.map((n,i)=>`
 <div class="order"><b>${escapeHTML(n.label)}</b>
 <div class="manage-row"><div><label class="field-label">اسم الخيار</label><input id="nav-label-${i}" value="${escapeHTML(n.label)}"></div>
 <div><label class="field-label">الأيقونة</label><input id="nav-icon-${i}" value="${escapeHTML(n.icon)}"></div></div>
 <label><input type="checkbox" id="nav-visible-${i}" ${n.visible===false?"":"checked"} style="display:inline-block;width:auto;min-height:0"> إظهار الخيار في القائمة السفلية</label>
 <button class="mini-btn" onclick="saveNavItem(${i})">حفظ الخيار</button></div>`).join("")+
 rooms.map((r,i)=>`<div class="order"><b>${escapeHTML(r.icon)} ${escapeHTML(r.name)}</b>
 <label class="field-label">اسم الروم</label><input id="room-name-${i}" value="${escapeHTML(r.name)}">
 <label class="field-label">الأيقونة</label><input id="room-icon-${i}" value="${escapeHTML(r.icon)}">
 <label class="field-label">الوصف</label><input id="room-desc-${i}" value="${escapeHTML(r.desc||"")}">
 <button class="mini-btn" onclick="saveRoom(${i})">حفظ الروم</button>
 <button class="mini-btn danger-btn" onclick="deleteRoom(${i})">حذف الروم</button></div>`).join("");
 const sel=document.getElementById("newProductRoom");
 if(sel){
 const opts=[["general","المتجر العام"],["protection","الحمايات"],["member","الأعضاء"],...rooms.map(r=>[r.id,r.name])];
 sel.innerHTML=opts.map(o=>`<option value="${escapeHTML(o[0])}">${escapeHTML(o[1])}</option>`).join("");
 }
}
function saveNavItem(i){
 const a=getNavItems();if(!a[i])return;
 a[i].label=document.getElementById("nav-label-"+i).value.trim()||a[i].label;
 a[i].icon=document.getElementById("nav-icon-"+i).value.trim()||"📁";
 a[i].visible=document.getElementById("nav-visible-"+i).checked;
 saveNavItems(a);renderRoomManager();
}
function addCustomRoom(){
 if(!masterUnlocked)return;
 const name=document.getElementById("newRoomName").value.trim();
 if(!name){alert("اكتب اسم الروم");return}
 const id="room_"+Date.now();
 const room={id,name,icon:document.getElementById("newRoomIcon").value.trim()||"📁",desc:document.getElementById("newRoomDesc").value.trim()};
 const rooms=getCustomRooms();rooms.push(room);saveCustomRooms(rooms);
 const nav=getNavItems();nav.splice(Math.max(0,nav.length-2),0,{id,label:name,icon:room.icon,custom:true});
 localStorage.setItem("rs_nav_items",JSON.stringify(nav));
 ensureRoomPages();renderNavigation();renderRoomManager();render();
 alert("تمت إضافة الروم");
}
function saveRoom(i){
 const rooms=getCustomRooms();if(!rooms[i])return;
 rooms[i].name=document.getElementById("room-name-"+i).value.trim()||rooms[i].name;
 rooms[i].icon=document.getElementById("room-icon-"+i).value.trim()||"📁";
 rooms[i].desc=document.getElementById("room-desc-"+i).value.trim();
 saveCustomRooms(rooms);
 const nav=getNavItems().map(n=>n.id===rooms[i].id?{...n,label:rooms[i].name,icon:rooms[i].icon}:n);
 localStorage.setItem("rs_nav_items",JSON.stringify(nav));
 ensureRoomPages();renderNavigation();renderRoomManager();render();
 alert("تم حفظ الروم");
}
function deleteRoom(i){
 const rooms=getCustomRooms();if(!rooms[i])return;
 const r=rooms[i];
 if(!confirm("حذف الروم؟ سيتم نقل منتجاته إلى المتجر العام."))return;
 items.forEach(p=>{if(p.type===r.id)p.type="general"});
 saveItems();rooms.splice(i,1);saveCustomRooms(rooms);
 localStorage.setItem("rs_nav_items",JSON.stringify(getNavItems().filter(n=>n.id!==r.id)));
 const page=document.getElementById(r.id);if(page)page.remove();
 renderNavigation();renderRoomManager();render();showPage("store");
}
function addProduct(){
 if(!masterUnlocked)return;
 const name=document.getElementById("newProductName").value.trim();
 const price=Number(document.getElementById("newProductPrice").value);
 if(!name||document.getElementById("newProductPrice").value===""||!Number.isFinite(price)||price<0){
 alert("اكتب اسم المنتج وسعراً صحيحاً");return;
 }
 const product={
 id:Date.now(),name,
 desc:document.getElementById("newProductDesc").value.trim(),
 price,
 icon:document.getElementById("newProductIcon").value.trim()||"🛍️",
 status:document.getElementById("newProductStatus").value,
 type:document.getElementById("newProductRoom").value
 };
 items.push(product);saveItems();render();renderMasterProducts();refreshAdmin();
 ["newProductName","newProductDesc","newProductPrice"].forEach(id=>document.getElementById(id).value="");
 alert("تمت إضافة المنتج");
}
function deleteProduct(id){
 if(!masterUnlocked||!confirm("تأكيد حذف المنتج نهائياً؟"))return;
 const idx=items.findIndex(x=>x.id===id);
 if(idx>=0){items.splice(idx,1);saveItems();render();renderMasterProducts();refreshAdmin()}
}
function addManagedAdmin(){
 if(!masterUnlocked)return;
 const name=document.getElementById("newAdminName").value.trim();
 const role=document.getElementById("newAdminRole").value;
 if(!name){alert("اكتب اسم الإداري");return}
 admins.push({id:Date.now(),name,role,active:true});
 saveAdmins();renderManagedAdmins();refreshAdmin();
 document.getElementById("newAdminName").value="";
}
function renderManagedAdmins(){
 document.getElementById("masterAdminList").innerHTML=admins.map(a=>`
 <div class="order"><b>${escapeHTML(a.name)}</b> — ${escapeHTML(a.role)}
 <button class="mini-btn" onclick="toggleAdmin(${a.id})">${a.active===false?"تفعيل":"إيقاف"}</button>
 <button class="mini-btn danger-btn" onclick="removeAdmin(${a.id})">حذف</button></div>`).join("")||"لا يوجد إداريون";
}
function toggleAdmin(id){
 const a=admins.find(x=>x.id===id);if(!a)return;
 a.active=a.active===false;saveAdmins();renderManagedAdmins();refreshAdmin();
}
function removeAdmin(id){
 if(!confirm("حذف الإداري؟"))return;
 admins=admins.filter(x=>x.id!==id);saveAdmins();renderManagedAdmins();refreshAdmin();
}
const originalRenderRoomManager=renderRoomManager;
function refreshMaster(){
 renderRoomManager();renderManagedAdmins();renderMasterProducts();
}
const oldVerifyMaster=verifyMaster;
verifyMaster=function(){
 oldVerifyMaster();
 if(masterUnlocked)refreshMaster();
};
function boot(){
 applyStoreSettings();
 ensureRoomPages();
 renderNavigation();
 render();
 const user=load("rs_current_user",null);
 if(user)enterStore(user);
 else{
 document.getElementById("registerGate").classList.add("active");
 document.getElementById("appContent").style.display="none";
 }
}
boot();
</script>
</body>
</html>